# Copy to .env for local testing (never commit the real .env — it's gitignored).
# GMAIL_APP_PASSWORD requires 2FA enabled on the Google account:
# https://myaccount.google.com/apppasswords

GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
EMAIL_TO=andyentre@gmail.com

# Only needed for the google_search_opportunities source (Custom Search JSON
# API - https://programmablesearchengine.google.com/ + a Google Cloud API key
# with the Custom Search API enabled). Free tier: 100 queries/day.
GOOGLE_SEARCH_API_KEY=your-api-key
GOOGLE_SEARCH_ENGINE_ID=your-search-engine-id
